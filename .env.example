# ============================================================
# NetworkTacticalRealm — Environment configuration template
# ============================================================
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit it.
#
# Generate fresh secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================

# --- Database ---
POSTGRES_DB=eduawd
POSTGRES_USER=eduawd
POSTGRES_PASSWORD=change_me_to_a_strong_password

# --- API ---
# Used by the platform's /admin/* endpoints. Keep this private.
ADMIN_TOKEN=change_me_admin_token

# Shared secret between the API checker and vulnboxes.
# Vulnboxes accept /set_flag only when this header matches.
# Must be the same value in API and every vulnbox container.
PLATFORM_TOKEN=change_me_platform_token

# --- DB connection string (built from values above) ---
DATABASE_URL=postgresql+psycopg://eduawd:change_me_to_a_strong_password@db:5432/eduawd
